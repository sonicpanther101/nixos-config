{
  "$schema": "https://opencode.ai/config.json",

  "model": "llamacpp/qwen3.6-35b-a3b",
  "small_model": "llamacpp/qwen3.6-35b-a3b",
  "share": "disabled",
  "autoupdate": false,

  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (host GPU)",
      "options": {
        "baseURL": "http://10.77.0.1:8081/v1",
        "apiKey": "none",
        "timeout": false
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B-A3B",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 262144, "output": 32768 }
        }
      }
    }
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 60000
  },

  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "skill": "allow",
    "external_directory": "allow",
    "doom_loop": "ask"
  },

  "mcp": {
    "context7": { "type": "remote", "url": "https://mcp.context7.com/mcp", "enabled": true }
  },

  "plugin": [
    "@bluelovers/opencode-arise",
    "opencode-throughput"
  ]
}
